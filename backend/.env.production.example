# ============================================================
# Backend — PRODUCTION Environment Variables (Render)
# ============================================================
# Copy these keys into your Render Web Service → Environment section.
# DO NOT put real values here — this file is committed to Git as a reference.
# Fill in the actual values in the Render dashboard.
# ============================================================

# Spring profile: activates application-prod.properties (PostgreSQL/Neon)
SPRING_PROFILES_ACTIVE=prod

# ── Neon PostgreSQL ───────────────────────────────────────────
# Get these from: https://console.neon.tech → Your Project → Connection Details
# Format: jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_secret

# ── LiveKit Cloud ─────────────────────────────────────────────
# Get from: https://cloud.livekit.io → Your Project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Mail (Gmail App Password) ─────────────────────────────────
# Gmail: Google Account → Security → 2-Step Verification → App Passwords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated, no trailing slash. Add your actual Render frontend URL.
FRONTEND_URLS=https://settribe-frontend.onrender.com

# ── Render sets this automatically — DO NOT set manually ─────
# PORT=8080
