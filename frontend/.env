# ─────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — .env
# Vite reads this file when running `npm run dev`
# VITE_API_BASE_URL is intentionally NOT set here so api.js
# falls back to http://localhost:8080/api automatically
# ─────────────────────────────────────────────────────────────

# Uncomment below ONLY if your local Spring Boot runs on a different port
# VITE_API_BASE_URL=http://localhost:8080/api

VITE_FRONTEND_URL=http://localhost:5173
