# ─────────────────────────────────────────────────────────────
# PRODUCTION — .env.production
# Vite reads this file when running `npm run build`
# These values are baked into the static bundle at build time.
# Set them as Environment Variables in the Render Static Site
# dashboard instead of committing real values here.
# ─────────────────────────────────────────────────────────────

# Your Render backend URL
VITE_API_BASE_URL=https://settribe-backend.onrender.com/api

# Your Render frontend URL (used when building interview invite links)
VITE_FRONTEND_URL=https://settribe-frontend.onrender.com
